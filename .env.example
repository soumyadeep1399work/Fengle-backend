# Server
PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=food_delivery
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# OTP (MSG91 example — swap for Fast2SMS/Twilio if needed)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Order cancellation buffer (seconds after placing during which a customer can
# still cancel, provided the restaurant hasn't accepted). Confirmed 60s by the user (2026-09-21).
ORDER_CANCEL_BUFFER_SECONDS=60

# GST invoice issuer (the platform, never the restaurant). Placeholders — client must supply real values.
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_GSTIN=
INVOICE_ISSUER_FSSAI=
INVOICE_ISSUER_ADDRESS=

# Rider earning rate (placeholder, never confirmed with client)
RIDER_RATE_PER_KM=8
RIDER_MIN_EARNING_PER_DELIVERY=15

# Absolute base URL put in uploaded-image links (POST /uploads/image). Leave unset in
# dev to use the request host, but set it to an address EVERY device can reach
# (e.g. http://192.168.1.16:4000) — a URL built from an emulator-only host such
# as 10.0.2.2 will not load on a real phone. Required in production.
PUBLIC_BASE_URL=

# Push notifications: path to the Firebase service-account JSON (Firebase console > Project settings > Service accounts).
# Keep the file out of git (secrets/ is gitignored). Unset = FCM pushes are skipped.
FCM_SERVICE_ACCOUNT_FILE=

# In-app agreement + owner/rider selfie verification (added 2026-09-29).
# Shared by restaurants and riders. Bump this to re-gate every account whose
# stored agreement_version is behind, without touching any row's data.
CURRENT_AGREEMENT_VERSION=1
