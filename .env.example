# Server
PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=food_delivery
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# OTP (MSG91 example — swap for Fast2SMS/Twilio if needed)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Order cancellation buffer (seconds after placing during which a customer can
# still cancel, provided the restaurant hasn't accepted). Placeholder — confirm with client.
ORDER_CANCEL_BUFFER_SECONDS=120

# GST invoice issuer (the platform, never the restaurant). Placeholders — client must supply real values.
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_GSTIN=
INVOICE_ISSUER_FSSAI=
INVOICE_ISSUER_ADDRESS=

# Rider earning rate (placeholder, never confirmed with client)
RIDER_RATE_PER_KM=8
RIDER_MIN_EARNING_PER_DELIVERY=15
